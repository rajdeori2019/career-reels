 "captions": [
  {
   "from": 0.99,
   "to": 2.74,
   "text": "Referral maang rahe ho,"
  },
  {
   "from": 11.16,
   "to": 12.96,
   "text": "Lekin job ka link nahi hai?"
  },
  {
   "from": 13.82,
   "to": 14.35,
   "text": "Maan lo,"
  },
  {
   "from": 15.38,
   "to": 18.87,
   "text": "LinkedIn par kisi employee ko message bhejte ho:"
  },
  {
   "from": 20.98,
   "to": 23.54,
   "text": "\"Hi sir, please refer me. I have"
  },
  {
   "from": 23.91,
   "to": 25.08,
   "text": "7 years of experience.\""
  },
  {
   "from": 28.76,
   "to": 33.15,
   "text": "Unhe kaise pata chalega ki kis opening ke liye refer karna hai?"
  },
  {
   "from": 35.27,
   "to": 38.04,
   "text": "Iske badle ye short message bhejo:"
  },
  {
   "from": 45.35,
   "to": 50.12,
   "text": "\"I saw a backend engineering opening, Job ID so-and-so, and this is the job link."
  },
  {
   "from": 50.56,
   "to": 54.25,
   "text": "I have 7 years of experience in Java Spring Boot,"
  },
  {
   "from": 54.84,
   "to": 55.57,
   "text": "etc.,"
  },
  {
   "from": 56.02,
   "to": 58.42,
   "text": "including API development as well."
  },
  {
   "from": 58.86,
   "to": 60.46,
   "text": "My resume is attached."
  },
  {
   "from": 60.98,
   "to": 63.11,
   "text": "If you think my profile is fit,"
  },
  {
   "from": 63.54,
   "to": 66.27,
   "text": "would you be comfortable referring me?\""
  },
  {
   "from": 74.64,
   "to": 80.32,
   "text": "Job ID sirf example hai. Actual opening ka link bhejna zaroori hai."
  },
  {
   "from": 82.54,
   "to": 90.02,
   "text": "Referral guarantee nahi, lekin saamne waale ke liye tumhara fit check karna easy ho jaata hai."
  },
  {
   "from": 96.22,
   "to": 99.48,
   "text": "Aur video useful lage toh save and share karna."
  }
 ],
