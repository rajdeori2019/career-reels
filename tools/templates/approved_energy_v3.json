 "captions": [
  {
   "from": 0.85,
   "to": 1.93,
   "text": "\"We have candidates.\""
  },
  {
   "from": 2.48,
   "to": 3.97,
   "text": "Ye client pitch hai?"
  },
  {
   "from": 14.37,
   "to": 16.4,
   "text": "Agar aap agency recruiter ho"
  },
  {
   "from": 16.85,
   "to": 22.35,
   "text": "aur cold DM mein ye line bhejoge, toh client ki actual hiring problem kaise samjhoge?"
  },
  {
   "from": 38.29,
   "to": 41.52,
   "text": "Maan lo company data engineering hire kar rahi hai."
  },
  {
   "from": 43.75,
   "to": 47.21,
   "text": "Pehle vacancy aur decision maker verify karo."
  },
  {
   "from": 47.68,
   "to": 48.43,
   "text": "Phir poocho:"
  },
  {
   "from": 57.34,
   "to": 60.48,
   "text": "\"Is role mein relevant shortlist banana challenging hai,"
  },
  {
   "from": 61.33,
   "to": 62.88,
   "text": "ya candidate availability?\""
  },
  {
   "from": 78.0,
   "to": 81.91,
   "text": "\"Agar gap hai, main apna search approach share kar sakta hoon.\""
  },
  {
   "from": 94.41,
   "to": 95.37,
   "text": "Agar interest aaya,"
  },
  {
   "from": 95.78,
   "to": 98.37,
   "text": "tab services aur terms discuss karo."
  },
  {
   "from": 111.66,
   "to": 114.97,
   "text": "Bina permission random CVs mat bhejo."
  },
  {
   "from": 118.44,
   "to": 123.16,
   "text": "Aur ye video useful lage toh apne agency recruiter doston ke saath share karo."
  }
 ],
