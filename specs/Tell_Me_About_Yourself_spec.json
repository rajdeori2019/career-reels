 "captions": [
  {
   "from": 1.18,
   "to": 3.61,
   "text": "Memorised intro hai?"
  },
  {
   "from": 4.06,
   "to": 7.11,
   "text": "Ye very dangerous weakness hai."
  },
  {
   "from": 7.3999999999999995,
   "to": 8.56,
   "text": "Aur candidate reply karta hai:"
  },
  {
   "from": 8.83,
   "to": 9.66,
   "text": "\"My name is Rahul,"
  },
  {
   "from": 10.15,
   "to": 10.75,
   "text": "B.Tech kiya hai,"
  },
  {
   "from": 11.38,
   "to": 12.63,
   "text": "aath saal ka experience hai"
  },
  {
   "from": 13.0,
   "to": 14.25,
   "text": "and I am very hardworking.\""
  },
  {
   "from": 14.84,
   "to": 16.09,
   "text": "Ruko! Aath saal ke baad bhi"
  },
  {
   "from": 16.41,
   "to": 18.83,
   "text": "introduction college pass-out jaisa lag raha hai."
  },
  {
   "from": 19.2,
   "to": 21.7,
   "text": "Tumhari relevant value sunai nahi de rahi."
  },
  {
   "from": 22.080000000000002,
   "to": 23.29,
   "text": "Uske badle ye line bolo:"
  },
  {
   "from": 23.54,
   "to": 26.53,
   "text": "\"I am a Java backend engineer with 8 years of experience."
  },
  {
   "from": 27.01,
   "to": 29.67,
   "text": "Recently, I diagnosed slow API queries"
  },
  {
   "from": 29.970000000000002,
   "to": 32.85,
   "text": "and validated improvements through repeatable load tests.\""
  },
  {
   "from": 33.099999999999994,
   "to": 35.67,
   "text": "Aur ye line add karo ki next role mein kya chahiye:"
  },
  {
   "from": 36.309999999999995,
   "to": 39.0,
   "text": "\"Now I'm exploring senior backend engineer roles"
  },
  {
   "from": 39.37,
   "to": 42.12,
   "text": "where I can contribute to performance and reliability.\""
  },
  {
   "from": 42.419999999999995,
   "to": 46.13,
   "text": "Bas: current role, one real proof, next role fit."
  },
  {
   "from": 46.72,
   "to": 47.91,
   "text": "Ye line bahut important hai:"
  },
  {
   "from": 48.4,
   "to": 50.07,
   "text": "current role, one genuine example,"
  },
  {
   "from": 50.89,
   "to": 53.93,
   "text": "why this role. Apna intro 30 second record karke suno"
  },
  {
   "from": 54.16,
   "to": 58.55,
   "text": "aur jo mention kiya, uske follow-up question ke liye ready raho."
  },
  {
   "from": 58.839999999999996,
   "to": 61.31,
   "text": "Agar aap interview answers ko better banana chahte ho,"
  },
  {
   "from": 61.559999999999995,
   "to": 64.31,
   "text": "toh maine ek practical Interview Answer Playbook banaya hai."
  },
  {
   "from": 64.86,
   "to": 67.2,
   "text": "Link profile mein hai. Please jao aur check karo."
  }
 ],
