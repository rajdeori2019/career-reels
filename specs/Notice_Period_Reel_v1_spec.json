  "captions": [
    {
      "from": 0.221,
      "to": 3.622,
      "text": "Notice period 90 days hai aur HR ko chahiye immediate joining."
    },
    {
      "from": 3.862,
      "to": 8.602,
      "text": "Mere recruitment career mein ek candidate tha jiska notice period 90 days tha."
    },
    {
      "from": 8.661,
      "to": 12.942,
      "text": "Aap soch rahe honge ki recruiter ne reject kar diya hoga. Nahi."
    },
    {
      "from": 13.022,
      "to": 15.681,
      "text": "Actually humne us candidate ke liye exactly 90 days wait kiya. Kyun?"
    },
    {
      "from": 16.341,
      "to": 21.041,
      "text": "Kyunki candidate aur recruiter ke beech mein bilkul clear communication tha."
    },
    {
      "from": 21.182,
      "to": 25.262,
      "text": "Achha understanding tha aur maine hiring manager se baat ki joining date negotiate kiya."
    },
    {
      "from": 25.562,
      "to": 29.862,
      "text": "Aur company ne candidate ke liye wait kiya aur after 90 days candidate ne joining bhi kar li."
    },
    {
      "from": 29.902,
      "to": 34.162,
      "text": "Ab ek bahut important baat samjho. Recruiter khaali aapka resume forward nahi karta."
    },
    {
      "from": 34.202,
      "to": 38.402,
      "text": "Aap right fit ho aur recruiter ke saath achha relation maintain kar rahe ho."
    },
    {
      "from": 38.422,
      "to": 42.302,
      "text": "Communicate kar rahe ho, recruiter actually aapke liye baat kar sakta hai."
    },
    {
      "from": 42.342,
      "to": 46.382,
      "text": "Joining date push kar sakta hai hiring manager ko convince kar sakta hai."
    },
    {
      "from": 46.402,
      "to": 50.122,
      "text": "Aur hiring process mein aapko guide bhi kar sakta hai. Next time koi recruiter aapko notice period poochhe."
    },
    {
      "from": 50.462,
      "to": 54.902,
      "text": "Toh jhootha promise mat karna. Apna actual notice period batao aur poochho."
    },
    {
      "from": 54.962,
      "to": 59.362,
      "text": "Mera actual notice period 90 days hai, but kya joining date flexible ho sakta hai?"
    },
    {
      "from": 59.502,
      "to": 62.882,
      "text": "Aap ye bhi bol sakte ho ki mere kuch leaves available hain."
    },
    {
      "from": 62.942,
      "to": 66.682,
      "text": "Jo aap notice period mein use kar sakte ho."
    },
    {
      "from": 66.741,
      "to": 71.902,
      "text": "Aur ye bhi sahi hai ki har company aapke liye wait nahi karegi. 90 days notice period matlab automatic rejection nahi hota."
    },
    {
      "from": 71.961,
      "to": 74.282,
      "text": "Video relatable lage toh save and share karna."
    }
  ],
