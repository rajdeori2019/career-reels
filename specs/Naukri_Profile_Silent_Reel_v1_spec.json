 "captions": [
  {
   "from": 0.0,
   "to": 2.69,
   "text": "Naukri profile 100% complete aur recruiters silent?"
  },
  {
   "from": 3.22,
   "to": 5.47,
   "text": "Tum roz Naukri refresh karte ho,"
  },
  {
   "from": 5.93,
   "to": 7.35,
   "text": "lekin relevant calls nahi aa rahe hain."
  },
  {
   "from": 7.76,
   "to": 11.1,
   "text": "Main dikhata hoon recruiter search mein kya check karte hain."
  },
  {
   "from": 11.36,
   "to": 13.83,
   "text": "Maan lo Senior Java Backend Engineer role hai"
  },
  {
   "from": 14.11,
   "to": 17.98,
   "text": "aur recruiter search karta hai Java, Spring Boot,"
  },
  {
   "from": 18.25,
   "to": 22.52,
   "text": "5-10 years of experience, location aur notice period wala filter use kar sakte hain."
  },
  {
   "from": 22.79,
   "to": 25.92,
   "text": "Ab maan lo Naukri mein tumhara headline IT Professional hai"
  },
  {
   "from": 26.18,
   "to": 29.12,
   "text": "aur responsibilities mein generic bullet points mentioned hain,"
  },
  {
   "from": 29.37,
   "to": 32.46,
   "text": "to tumhara actual skills aur evidence clear nahi hai,"
  },
  {
   "from": 32.87,
   "to": 35.97,
   "text": "aur recruiter ke search mein tumhara profile show hi nahi hoga."
  },
  {
   "from": 36.14,
   "to": 38.38,
   "text": "Tumhare profile mein koi recruiter view nahi kar raha,"
  },
  {
   "from": 38.92,
   "to": 41.34,
   "text": "to iska matlab discoverability ka problem hai."
  },
  {
   "from": 41.61,
   "to": 44.7,
   "text": "To usko aap kaise resolve kar sakte ho? Usko keywords,"
  },
  {
   "from": 44.93,
   "to": 48.96,
   "text": "roles and responsibilities wagera add karke update kar sakte ho."
  },
  {
   "from": 49.21,
   "to": 51.01,
   "text": "Aapka profile recruiter view kar raha hai,"
  },
  {
   "from": 51.37,
   "to": 53.59,
   "text": "lekin calls nahi aa rahe hain,"
  },
  {
   "from": 54.0,
   "to": 56.79,
   "text": "iska matlab search mein aapka profile dikhai de raha hai,"
  },
  {
   "from": 57.19,
   "to": 59.17,
   "text": "lekin jo roles and responsibilities hai"
  },
  {
   "from": 59.34,
   "to": 62.19,
   "text": "woh convincing nahi hai taaki recruiter aapko call kare."
  },
  {
   "from": 62.46,
   "to": 64.44,
   "text": "To ismein aap kya kar sakte ho?"
  },
  {
   "from": 64.73,
   "to": 68.38,
   "text": "Roles and responsibilities ko teen different types mein likh sakte ho:"
  },
  {
   "from": 68.63,
   "to": 74.07,
   "text": "kya problem tha, aapne exactly kya kiya, aur finally outcome kya tha."
  },
  {
   "from": 74.24,
   "to": 76.49,
   "text": "Agar aap roles and responsibilities ko aise likhoge,"
  },
  {
   "from": 76.77,
   "to": 79.82,
   "text": "to aapke paas calls aana start ho jayenge."
  },
  {
   "from": 80.01,
   "to": 82.4,
   "text": "Agar aapke paas wrong calls aa rahe hain,"
  },
  {
   "from": 82.73,
   "to": 85.52,
   "text": "iska matlab job preference mein kuch issue hai."
  },
  {
   "from": 85.68,
   "to": 88.65,
   "text": "Bahut saare job preference select kar rakha hoga."
  },
  {
   "from": 88.86,
   "to": 91.29,
   "text": "Main aapko recommend karta hoon ki 2-3"
  },
  {
   "from": 91.61,
   "to": 93.85,
   "text": "specific role jismein aap move karna chahte ho, woh role target karo."
  },
  {
   "from": 94.05,
   "to": 97.59,
   "text": "Agar review mein accha laga to recruiter aapko zaroor call karenge."
  },
  {
   "from": 97.83,
   "to": 101.61,
   "text": "Call mein role wagera matching hota hai, then interview schedule hoga."
  },
  {
   "from": 101.81,
   "to": 104.79,
   "text": "Random profiles update mat karo, aur koi bhi guarantee"
  },
  {
   "from": 104.96,
   "to": 107.15,
   "text": "call, hack, pay blindly trust mat karo."
  },
  {
   "from": 107.46,
   "to": 109.48,
   "text": "Yeh sirf ek practical example tha."
  },
  {
   "from": 109.63,
   "to": 114.72,
   "text": "Real experience ko real time practice karne ke liye maine ek practical resource banaya hai,"
  },
  {
   "from": 114.94,
   "to": 119.39,
   "text": "complete details website mein hai, website ka link bio mein hai, please check kar lena."
  }
 ],
